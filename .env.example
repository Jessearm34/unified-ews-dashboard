# ─────────────────────────────────────────────────────────────
# EWS Unified Dashboard — environment variables
# Set these in Railway → unified-ews-dashboard → Variables.
# ─────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────
# ONE Postgres holds all four sources (table-prefixed):
#   quickbooks_*   sitedocs_*   geotab tables   insperity_*
# Every module falls back to DATABASE_URL, so you can set just
# this one variable. The four *_DATABASE_URL overrides below are
# optional — only set them if you keep separate databases.
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/ews

# Optional per-platform overrides (leave unset to use DATABASE_URL):
#QB_DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/quickbooks
#SD_DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/sitedocs
#GT_DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/geotab

# ── Dashboard auth ──────────────────────────────────────────
DASHBOARD_LOGIN_DOMAIN=energywatersolutions.com
DASHBOARD_LOGIN_PASSWORD=replace-me
# DASHBOARD_LOGIN_PASSWORD_HASH=pbkdf2_sha256$...

# Session signing (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SESSION_SECRET=replace-with-a-long-random-secret

# Server
PORT=8000

# ── QuickBooks (refresh/refresh.py) ─────────────────────────
# client_id + client_secret + realm_id come from the Intuit Developer
# Portal (developer.intuit.com). Access/refresh tokens live in the
# oauth_tokens table; set these only as a fallback.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REALM_ID=
QUICKBOOKS_ENVIRONMENT=production
# QUICKBOOKS_ACCESS_TOKEN=      # optional — DB has it
# QUICKBOOKS_REFRESH_TOKEN=     # optional — DB has it

# ── SiteDocs ────────────────────────────────────────────────
SITEDOCS_API_TOKEN=
SITEDOCS_BASE_URL=https://api.sitedocs.com

# ── GeoTab ──────────────────────────────────────────────────
# GeoTab auth is a username/password/database triple (or API key).
GEOTAB_USERNAME=
GEOTAB_PASSWORD=
GEOTAB_DATABASE=

# ── Insperity (pull_insperity.py — runs on DO droplet, static IP) ──
INSPERITY_CLIENT_ID=
INSPERITY_API_KEY=
INSPERITY_BASE_URL=https://api.insperity.com
