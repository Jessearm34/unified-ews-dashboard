# ─────────────────────────────────────────────────────────────
# EWS Unified Dashboard — environment variables
# Set these in Railway → unified-ews-dashboard → Variables.
# Values here are placeholders; real secrets live ONLY in Railway.
# ─────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────
# ONE Postgres holds all four sources (table-prefixed):
#   quickbooks_*   sitedocs_*   geotab tables   insperity_*
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/ews

# ── Dashboard auth ──────────────────────────────────────────
DASHBOARD_LOGIN_DOMAIN=energywatersolutions.com
DASHBOARD_LOGIN_PASSWORD=replace-me
# DASHBOARD_LOGIN_PASSWORD_HASH=pbkdf2_sha256$...

# Session signing (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SESSION_SECRET=replace-with-a-long-random-secret

# ── QuickBooks (refresh/quickbooks) ─────────────────────────
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REALM_ID=
QUICKBOOKS_ACCESS_TOKEN=
QUICKBOOKS_REFRESH_TOKEN=

# ── SiteDocs (refresh/sitedocs) ─────────────────────────────
SITEDOCS_API_KEY=
SITEDOCS_COMPANY_ID=
SITEDOCS_EMPLOYEE_ID=
# SITEDOCS_API_BASE defaults to https://api-1.sitedocs.com

# ── GeoTab (separate sync worker: geotab-data-export) ───────
# These live in the geotab-data-export deployment, which writes
# into this same DATABASE_URL every ~15 min. Not read here.
# GEOTAB_DATABASE / GEOTAB_USERNAME / GEOTAB_PASSWORD / GEOTAB_SERVER

# ── Insperity (pull_insperity.py — runs on DO droplet, static IP) ──
# Not needed here — the droplet pushes insperity_* into DATABASE_URL.
