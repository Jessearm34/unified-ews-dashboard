# PostgreSQL databases — separate per platform
QB_DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/quickbooks
SD_DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/sitedocs
GT_DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/geotab

# Dashboard auth
DASHBOARD_LOGIN_DOMAIN=energywatersolutions.com
DASHBOARD_LOGIN_PASSWORD=replace-me
